# Example unit for the optional Streamable HTTP transport, reachable only over
# Tailscale. Not needed for local MCP clients: they should spawn `wacli-mcp`
# over stdio instead.
#
# Install (as root), after replacing every CHANGE_ME:
#   install -m 0644 deploy/wacli-mcp-http.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now wacli-mcp-http
[Unit]
Description=wacli MCP server (Streamable HTTP, tailnet only)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME_USER
ExecStart=/home/CHANGE_ME_USER/.local/bin/wacli-mcp http
# This machine's Tailscale address (`tailscale ip -4`). Loopback also works.
Environment=WACLI_MCP_HTTP_HOST=CHANGE_ME_TAILSCALE_IP
Environment=WACLI_MCP_HTTP_PORT=8765
# MagicDNS names clients may use in the Host header, comma separated.
Environment=WACLI_MCP_ALLOWED_HOSTNAMES=CHANGE_ME_HOSTNAME
Environment=WACLI_MCP_TOKEN_FILE=/home/CHANGE_ME_USER/.config/wacli-mcp/token
Environment=WACLI_MCP_AUDIT_LOG=/home/CHANGE_ME_USER/.local/state/wacli-mcp/audit.jsonl
# Optional sending (see README, Sending). Needs `wacli sync --follow` running
# for this store; prefer a stdio client with elicitation over HTTP for sends.
#Environment=WACLI_MCP_STORE=/home/CHANGE_ME_USER/.local/state/wacli
#Environment=WACLI_MCP_ENABLE_SEND=1
#Environment=WACLI_MCP_SEND_RECIPIENTS=me=CHANGE_ME_JID
UMask=0077
Restart=on-failure
RestartSec=10

# Hardening. RestrictNamespaces= must stay unset: every wacli call runs inside
# `unshare -rn` (an empty network namespace).
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
# The wacli store must be writable only for SQLite's shared-memory file when
# `wacli sync --follow` keeps the database in WAL mode; wacli itself runs with
# --read-only and WACLI_READONLY=1 for reads. Sends also connect to the
# daemon's .send.sock in that directory. Point the first path at your actual
# store (older installs use ~/.wacli); the leading "-" lets the unit start if
# it is absent. The audit log directory is required.
ReadWritePaths=-/home/CHANGE_ME_USER/.local/state/wacli /home/CHANGE_ME_USER/.local/state/wacli-mcp
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
